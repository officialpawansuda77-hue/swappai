# ── Client (bundled into the browser — public values only) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Background removal (self-hosted rembg service for HD mode)
VITE_BG_REMOVAL_API_URL=https://swappai-bg-removal.onrender.com
VITE_BG_REMOVAL_API_KEY=your-bg-api-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ── Server only (Vercel /api functions). NEVER prefix these with VITE_ ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GEMINI_API_KEY=your-gemini-key-here
APMIX_API_KEY=your-apmix-key-here
APMIX_BASE_URL=https://api.apmix.ai/v1
# Used to build checkout return URLs (no trailing slash)
PUBLIC_APP_URL=https://swappai.example.com

# Dodo Payments (server-side only)
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=your-dodo-api-key-here
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret-here

# INR plan products (create these in the Dodo dashboard)
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_PRO=
DODO_PRODUCT_BUSINESS=
DODO_PRODUCT_AGENCY=

# One-off AI credit top-up
DODO_EXTRA_CREDITS_PRODUCT_ID=
DODO_EXTRA_CREDITS_AMOUNT=15

# Legacy USD products (still mapped: creator→creator, studio→pro)
DODO_CREATOR_PRODUCT_ID=pdt_0NoV6f6sKvSHpmZrs8uPj
DODO_STUDIO_PRODUCT_ID=pdt_0NoV8Hg2oW2DEM5YbUHGz
